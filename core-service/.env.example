# Core Service - Environment Configuration
# Copy this file to .env and fill in with actual values

# ==========================================
# DATABASE
# ==========================================
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_USER=admin
APP_DB_PASSWORD=changeme
APP_DB_NAME=app_db
APP_DB_SSL=true

# Optional: Processing database (currently unused)
PROCESSING_DB_HOST=localhost
PROCESSING_DB_PORT=5432
PROCESSING_DB_USER=admin
PROCESSING_DB_PASSWORD=changeme
PROCESSING_DB_NAME=processing_db
PROCESSING_DB_SSL=true

# ==========================================
# SERVER
# ==========================================
PORT=7090
NODE_ENV=production
WEB_URL=http://localhost:3000

# ==========================================
# OPENAI
# ==========================================
OPENAI_API_KEY=sk-YOUR_KEY_HERE
OPENAI_ASSISTANT_MODEL=gpt-5-nano

# ==========================================
# FIREBASE
# ==========================================
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project","private_key":"..."}'
FIREBASE_PROJECT_ID=your-firebase-project-id

# ==========================================
# AWS S3
# ==========================================
AWS_ACCESS_KEY_ID=YOUR_AWS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET
ONBOARDING_BUCKET_PATH=s3://your-bucket/path/

# ==========================================
# YOUTUBE
# ==========================================
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY
THINKO_CHANNEL_ID_EN=UCxxxxxx
THINKO_CHANNEL_ID_HI=UCxxxxxx

# ==========================================
# INTERNAL
# ==========================================
INTERNAL_API_SECRET=your_secret_key_here

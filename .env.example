# ThinkO News Platform - Environment Configuration
# Copy this file to .env and fill in with actual values
# Never commit the .env file to version control

# ==========================================
# DATABASE CONFIGURATION
# ==========================================

# Primary Database (DB1) - Used by NECLS Backend for pipeline processing
# Format: postgresql://user:password@host:port/database
FEEDCRAWLER_DB=postgresql://admin:changeme@postgres:5432/feedcrawler_db
FEEDCRAWLER_DB_HOST=postgres
FEEDCRAWLER_DB_PORT=5432
FEEDCRAWLER_DB_USER=admin
FEEDCRAWLER_DB_PASSWORD=changeme
FEEDCRAWLER_DB_NAME=feedcrawler_db
FEEDCRAWLER_DB_SSL=true

# Application Database (DB2) - Customer-facing database, mirrored from DB1
# Used by both NECLS Backend for syncing and Core Service for serving content
APP_DB=postgresql://admin:changeme@postgres:5432/app_db
APP_DB_HOST=postgres
APP_DB_PORT=5432
APP_DB_USER=admin
APP_DB_PASSWORD=changeme
APP_DB_NAME=app_db
APP_DB_SSL=true

# Optional: Processing Database (currently unused in Core Service)
PROCESSING_DB_HOST=postgres
PROCESSING_DB_PORT=5432
PROCESSING_DB_USER=admin
PROCESSING_DB_PASSWORD=changeme
PROCESSING_DB_NAME=processing_db
PROCESSING_DB_SSL=true

# ==========================================
# SERVER CONFIGURATION
# ==========================================

# Core Service API port
PORT=7090

# Node environment
NODE_ENV=production

# Web URL for CORS and redirects
WEB_URL=http://localhost:3000

# ==========================================
# AI & LLM CONFIGURATION
# ==========================================

# OpenAI API Keys (get from https://platform.openai.com/api-keys)
# Used for: Chat completions, embeddings, text-to-speech
OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE
OPENAI_API_KEY2=sk-YOUR_OPENAI_KEY2_FOR_PARALLEL_PROCESSING

# Model configuration
OPENAI_ASSISTANT_MODEL=gpt-5-nano

# ==========================================
# GOOGLE SERVICES
# ==========================================

# Google Gemini API Key (for text-to-speech in NECLS)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_API_KEY2=YOUR_GEMINI_API_KEY2_FOR_PARALLEL_PROCESSING

# YouTube API Key (for YouTube content extraction)
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY

# ==========================================
# AWS CONFIGURATION
# ==========================================

# AWS Access Credentials (for S3 and other AWS services)
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
AWS_DEFAULT_REGION=ap-south-1

# S3 Bucket for audio files (TTS output)
AUDIO_BUCKET=your-audio-bucket-name
AUDIO_PREFIX=audio/

# S3 Bucket for backup images
BACKUP_IMAGES_BUCKET=your-backup-bucket-name
BACKUP_IMAGES_PREFIX=images/backup/

# S3 Bucket for storing generated images/assets
ONBOARDING_BUCKET_PATH=s3://your-onboarding-bucket/path/

# ==========================================
# FIREBASE CONFIGURATION
# ==========================================

# Firebase Service Account (full JSON object as string)
# Download from: Firebase Console > Project Settings > Service Accounts
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"firebase@your-project.iam.gserviceaccount.com"}'

# Firebase project info
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase@your-project.iam.gserviceaccount.com

# ==========================================
# NOTIFICATION SERVICES
# ==========================================

# Firebase Cloud Messaging (push notifications)
# Configured via FIREBASE_SERVICE_ACCOUNT above

# Slack Webhook for alerts
SLACK_ALERT_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ==========================================
# NECLS BACKEND SPECIFIC
# ==========================================

# Pipeline scheduling
# 0 = run once and exit
# >0 = run every N minutes
PIPELINE_INTERVAL_MIN=0

# Article extraction
# Only extract articles from the last N hours
EXTRACT_HOURS_RECENCY=24

# Clustering configuration
# Time window for clustering articles together (in hours)
CLUSTERING_HOURS=24
CLUSTER_BATCH_SIZE=100
MAX_CLUSTERS_TO_PROCESS=50

# Clustering thresholds
# Lower = more liberal clustering (more articles grouped together)
# Higher = stricter clustering (fewer articles grouped)
CLUSTERING_THRESHOLD=0.6
CLUSTERING_THETA=0.55

# Google News backfill
# How many years back to search for historical articles
GNEWS_MAX_YEARS=2

# ==========================================
# NECLS WEBADMIN CONFIGURATION
# ==========================================

# Initial admin credentials (for editorial UI)
# These are used only on first setup to create the admin user
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=changeme_for_production

# Core Service URL (for backlinks in webadmin)
CORE_SERVICE_URL=http://localhost:7090

# ==========================================
# EXTERNAL API KEYS
# ==========================================

# Hugging Face API Token (for embeddings)
# Get from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_YOUR_HUGGINGFACE_TOKEN

# Sarvam AI API Key (Hindi language support)
SARVAM_API_KEY=YOUR_SARVAM_API_KEY

# PostHog Analytics
POSTHOG_API_KEY=YOUR_POSTHOG_KEY
POSTHOG_PROJECT_ID=YOUR_POSTHOG_PROJECT_ID

# ==========================================
# INTERNAL CONFIGURATION
# ==========================================

# Internal API secret for inter-service communication
INTERNAL_API_SECRET=your_internal_api_secret_keep_secure

# ==========================================
# OPTIONAL CONFIGURATION
# ==========================================

# Crawl interval for feed polling (minutes)
CRAWL_INTERVAL=15

# Model cache directory (NECLS)
MODEL_CACHE_DIR=.model-cache

# Verbose logging
VERBOSE=false

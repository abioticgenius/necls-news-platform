# NECLS Backend - Environment Configuration
# Copy this file to .env and fill in with actual values

# ==========================================
# PRIMARY DATABASE (DB1 - Pipeline)
# ==========================================
FEEDCRAWLER_DB=postgresql://admin:changeme@localhost:5432/feedcrawler_db
FEEDCRAWLER_DB_HOST=localhost
FEEDCRAWLER_DB_PORT=5432
FEEDCRAWLER_DB_USER=admin
FEEDCRAWLER_DB_PASSWORD=changeme
FEEDCRAWLER_DB_NAME=feedcrawler_db
FEEDCRAWLER_DB_SSL=true

# ==========================================
# APPLICATION DATABASE (DB2 - Customer App)
# ==========================================
APP_DB=postgresql://admin:changeme@localhost:5432/app_db
APP_DB_HOST=localhost
APP_DB_PORT=5432
APP_DB_USER=admin
APP_DB_PASSWORD=changeme
APP_DB_NAME=app_db
APP_DB_SSL=true

# ==========================================
# OPENAI API
# ==========================================
# Primary key for LLM processing
OPENAI_API_KEY=sk-YOUR_KEY_HERE
# Secondary key for parallel processing
OPENAI_API_KEY2=sk-YOUR_KEY2_HERE

# ==========================================
# GOOGLE SERVICES
# ==========================================
# Gemini API for text-to-speech
GEMINI_API_KEY=YOUR_GEMINI_KEY
GEMINI_API_KEY2=YOUR_GEMINI_KEY2

# ==========================================
# AWS CONFIGURATION
# ==========================================
AWS_ACCESS_KEY_ID=YOUR_AWS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET
AWS_DEFAULT_REGION=ap-south-1

# Audio storage
AUDIO_STORAGE=s3
AUDIO_BUCKET=your-audio-bucket
AUDIO_PREFIX=audio/

# Image backup
BACKUP_IMAGES_BUCKET=your-backup-bucket
BACKUP_IMAGES_PREFIX=images/

# ==========================================
# FIREBASE
# ==========================================
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project",...}'

# ==========================================
# PIPELINE CONFIGURATION
# ==========================================
# 0 = run once and exit, >0 = run every N minutes
PIPELINE_INTERVAL_MIN=60

# Extract articles from last N hours
EXTRACT_HOURS_RECENCY=24

# Clustering settings
CLUSTERING_HOURS=24
CLUSTER_BATCH_SIZE=100
MAX_CLUSTERS_TO_PROCESS=50

# Clustering thresholds (0.0-1.0)
# THETA: centroid similarity threshold (default: 0.55)
# THRESHOLD: agglomerative distance threshold (default: 0.6)
CLUSTERING_THETA=0.55
CLUSTERING_THRESHOLD=0.6

# Google News backfill
GNEWS_MAX_YEARS=2

# ==========================================
# WEBADMIN CONFIGURATION
# ==========================================
# Initial admin user (created on first startup)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=changeme_please

# Core Service URL
CORE_SERVICE_URL=http://localhost:7090

# ==========================================
# EXTERNAL API KEYS
# ==========================================
# Hugging Face (embeddings)
HF_TOKEN=hf_YOUR_TOKEN

# Sarvam AI (Hindi language)
SARVAM_API_KEY=YOUR_SARVAM_KEY

# PostHog Analytics
POSTHOG_API_KEY=YOUR_POSTHOG_KEY
POSTHOG_PROJECT_ID=YOUR_POSTHOG_PROJECT_ID

# Slack Alerts
SLACK_ALERT_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ==========================================
# INTERNAL
# ==========================================
INTERNAL_API_SECRET=your_secret_key_here

# ==========================================
# OPTIONAL
# ==========================================
CRAWL_INTERVAL=15
VERBOSE=false
